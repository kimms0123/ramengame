--- !u!114 &236457946
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 236457935}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b09c7e803ba06ae448fc8893f0375a2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RamenTycoon.UI.TutorialGuide
  builtObjects:
  - {fileID: 2096349690}
  - {fileID: 106002615}
  - {fileID: 706172687}
  - {fileID: 1618550404}
  showOnlyOnce: 0
  lockOtherStations: 1
  waitMessageSeconds: 4
  finalMessageSeconds: 7
  gapSeconds: 0.4
  popSeconds: 0.15
  skipKey: 3
  skipHoldSeconds: 1
  guideMessages:
  - "\uC624\uB298\uBD80\uD130 \uB2F9\uC2E0\uC758 \uAC00\uAC8C\uC785\uB2C8\uB2E4!\n\uC190\uB2D8\uC774 \uB4E4\uC5B4\uC640\uC11C <b>\uC8FC\uBB38\uD560 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB824 \uBCF4\uC138\uC694</b>..."
  - "\uC8FC\uBB38\uC774 \uB4E4\uC5B4\uC654\uC5B4\uC694! \uBA3C\uC800 <b>\uBA74\uC744 \uC0B6\uC544\uC694</b>.\n\uD654\uC0B4\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB294 <b>\uBA74 \uC0C1\uC790</b>\uC5D0\uC11C <b>E</b>\uB97C \uB20C\uB7EC \uBA74\uC744 \uAEBC\uB0B4\uC694."
  - "<b>\uD654\uAD6C</b>\uB85C \uAC00\uC11C <b>E</b>\uB97C \uB20C\uB7EC \uBA74\uC744 \uB123\uC5B4\uC694.\n\uBA74\uC774 \uC0B6\uC544\uC9C0\uAE30 \uC2DC\uC791\uD574\uC694!"
  - "\uBA74\uC774 \uC0B6\uC544\uC9C0\uB294 \uB3D9\uC548 <b>\uC2F1\uD06C\uB300 \uC606 \uBE48 \uADF8\uB987</b>\uC5D0\uC11C\n<b>E</b>\uB97C \uB20C\uB7EC \uADF8\uB987\uC744 \uB4E4\uC5B4\uC694."
  - "\uBA74\uC774 \uB2E4 \uC775\uC5C8\uC5B4\uC694! \uADF8\uB987\uC744 \uB4E0 \uCC44\uB85C\n<b>\uD654\uAD6C</b>\uC5D0\uC11C <b>E</b>\uB97C \uB20C\uB7EC \uBA74\uC744 \uAC74\uC838\uC694."
  - "\uC774 \uC190\uB2D8\uC740 <b>{broth}</b>\uB97C \uC8FC\uBB38\uD588\uC5B4\uC694.\n<b>{broth} \uC721\uC218 \uD1B5</b>\uC5D0\uC11C <b>E</b>\uB97C \uB20C\uB7EC \uC721\uC218\uB97C \uBD80\uC5B4\uC694."
  - "\uC774\uC81C \uACE0\uBA85\uC744 \uC5B9\uC744 \uCC28\uB840\uC608\uC694. <b>\uD1A0\uD551\uB300</b>\uB85C \uAC00\uC11C\n<b>E</b>\uB97C \uB20C\uB7EC \uACE0\uBA85 \uD654\uBA74\uC744 \uC5F4\uC5B4\uC694."
  - "\uC8FC\uBB38\uC11C\uB300\uB85C \uACE0\uBA85\uC744 \uC5B9\uC5B4\uC694: <b>{toppings}</b>\n\uD654\uC0B4\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB294 <b>\uACE0\uBA85 \uD1B5\uC744 \uD074\uB9AD</b>\uD574 \uC9D1\uACE0 <b>\uADF8\uB987\uC744 \uD074\uB9AD</b>\uD574 \uC5B9\uC5B4\uC694."
  - "\uACE0\uBA85\uC744 \uB2E4 \uC5B9\uC5C8\uC5B4\uC694!\n<b>\uC885</b>\uC744 \uB20C\uB7EC(Enter) \uB77C\uBA58\uC744 \uC644\uC131\uD574\uC694."
  - "\uB77C\uBA58 \uC644\uC131! <b>{table}\uBC88 \uD14C\uC774\uBE14</b> \uC190\uB2D8\uC5D0\uAC8C \uAC00\uC11C\n<b>E</b>\uB97C \uB20C\uB7EC \uC11C\uBE59\uD574\uC694."
  - "\uC798\uD588\uC5B4\uC694! \uC190\uB2D8\uC774 \uB2E4 \uBA39\uC73C\uBA74 <b>\uBE48 \uADF8\uB987\uC744 \uCE58\uC6CC \uC2F1\uD06C\uB300</b>\uC5D0 \uB123\uC5B4\uC694.\n\uB3C8\uC774 \uBAA8\uC774\uBA74 \uC624\uB978\uCABD \uC544\uB798 <b>\uD0DC\uBE14\uB9BF(U)</b>\uC5D0\uC11C \uD654\uAD6C\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC5B4\uC694."
  noodleCookingMessage: "\uBA74\uC774 \uC775\uB294 \uC911\uC774\uC5D0\uC694... \uB0C4\uBE44 \uC704 \uAC8C\uC774\uC9C0\uAC00 \uB2E4 \uCC28\uBA74(\uB775\uB3D9!)\n\uADF8\uB987\uC744 \uB4E0 \uCC44\uB85C <b>\uD654\uAD6C</b>\uC5D0\uC11C <b>E</b>\uB97C \uB20C\uB7EC \uBA74\uC744 \uB2F4\uC544\uC694."
  toppingHoldingMessage: "<b>{holding}</b>\uC744(\uB97C) \uC9D1\uC5C8\uC5B4\uC694! \uC774\uC81C <b>\uADF8\uB987\uC744 \uD074\uB9AD</b>\uD574 \uC62C\uB824\uC694.\n\uB0A8\uC740 \uD1A0\uD551: <b>{left}</b>"
  blockedHint: "\uD654\uC0B4\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB294 \uACF3\uC73C\uB85C \uAC00\uC694!"
  arrowSize: 64
